{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxide",
  "version": "1.0.4",
  "identifier": "dev.oxide.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run extension",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxide",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://oxide-artifact.localhost oxide-artifact: http://oxide-app.localhost oxide-app:; worker-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Oxide contributors",
    "copyright": "Copyright © 2026 Oxide contributors",
    "category": "Productivity",
    "shortDescription": "A desktop AI assistant",
    "longDescription": "Oxide is a desktop AI assistant written in Rust on Tauri: chats with Anthropic, OpenAI-compatible and local models, MCP connectors, projects, artifacts, agentic tools, a browser agent, a Chrome extension, scheduled tasks and computer use.",
    "license": "MIT OR Apache-2.0",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/uv"],
    "resources": {
      "../extension/dist/": "extension/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["oxide"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RDU3RkU1RkY0Nzc1QjgKUldTNGRVZi81WC9WbGR1Qy9OU1B1K2dNNlVpNVY1UWE0dm1PYjJXN0IyWkFyaDBZOTNoZGZ3aDMK"
    }
  }
}
